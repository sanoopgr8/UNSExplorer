{
  "name": "uns-explorer",
  "version": "1.0.0",
  "description": "UNS Explorer - Unified Namespace MQTT Browser",
  "main": "dist/src/main/index.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k -n VITE,ELECTRON -c cyan,yellow \"vite --port 3000 --strictPort\" \"wait-on http-get://localhost:3000 && cross-env NODE_ENV=development VITE_PORT=3000 electron .\"",
    "dev:vite": "vite --port 3000 --strictPort",
    "dev:electron": "cross-env NODE_ENV=development VITE_PORT=3000 electron .",
    "build:main": "tsc --project tsconfig.node.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "preview": "vite preview",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "deploy": "node scripts/deploy.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "fuse.js": "^7.0.0",
    "mqtt": "^5.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "happy-dom": "^20.10.1",
    "jsdom": "^21.1.2",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.3.1",
    "vitest": "^2.1.9",
    "wait-on": "^7.2.0"
  }
}
